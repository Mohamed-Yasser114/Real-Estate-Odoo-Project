<odoo>
    <record id="owner_list_view" model="ir.ui.view">
        <field name="name">owner_list_view</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="address"/>
                <field name="property_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="owner_form_view" model="ir.ui.view">
        <field name="name">owner.view.form</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                       <field name="phone"/>
                        <field name="address"/>
                        <field name="property_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="owner_action" model="ir.actions.act_window">
        <field name="name">Owner</field>
        <field name="res_model">owner</field>
    </record>
    <menuitem id="owners_list_item" name="Owners List" parent="owners_menu" action="owner_action"/>
</odoo>