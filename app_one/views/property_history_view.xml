<odoo>
    <record id="property_history_view" model="ir.ui.view">
        <field name="name">property.history.view.form</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="old_state"/>
                            <field name="new_state"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bedrooms">
                            <field name="line_ids" readonly="1">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="area"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="property_history_list_view" model="ir.ui.view">
        <field name="name">property.history.view.list</field>
        <field name="model">property.history</field>
        <field name="arch" type="xml">
            <list class="header_custom" create="0" edit="0" delete="0">
                <field name="user_id"/>
                <field name="property_id"/>
                <field name="old_state"/>
                <field name="new_state"/>
            </list>
        </field>
    </record>
    <record id="property_history_action" model="ir.actions.act_window">
        <field name="name">Property history</field>
        <field name="res_model">property.history</field>
    </record>
    <menuitem id="property_history_menu_item" name="Property History" parent="properties_menu" action="property_history_action" groups="app_one.property_manager_group"/>
</odoo>
